# Copy to .env for local development. Never commit real credentials.
APP_ENVIRONMENT=development
STORAGE_BACKEND=local
APP_PASSWORD=replace-with-a-long-random-development-password

# Supabase values are intentionally blank until the project is provisioned.
# Keep the service-role key server-side only. Never put it in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=open-ml-artifacts

MAX_UPLOAD_MB=100
MAX_DATASET_ROWS=500000
