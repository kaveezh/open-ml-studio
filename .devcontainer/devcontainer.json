{
  "name": "Open ML Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Open ML Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r backend/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}